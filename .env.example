# ---------------------------------------------------------------- environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api

# ---------------------------------------------------------------- persistence
# Compose uses PostgreSQL. Local dev without Docker falls back to SQLite.
DATABASE_URL=postgresql+psycopg://ldai:ldai@postgres:5432/ldai
# DATABASE_URL=sqlite+pysqlite:///./ldai.db

REDIS_URL=redis://redis:6379/0
# inline  = run jobs in-process (dev/test, no Redis needed)
# arq     = enqueue to the Redis-backed worker
TASK_QUEUE_BACKEND=arq

# ---------------------------------------------------------------- storage
# local | s3
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=./var/documents
S3_ENDPOINT=http://minio:9000
S3_BUCKET=legal-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---------------------------------------------------------------- llm
# Any OpenAI-compatible endpoint (vLLM, TGI, llama.cpp server, OpenAI itself).
LLM_BASE_URL=http://model-server:8000/v1
LLM_MODEL=Qwen3-VL-8B-Instruct
LLM_API_KEY=not-needed-for-local-vllm
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
# Minimum seconds between model requests. Free tiers cap requests per minute;
# spacing calls is cheaper than discovering the cap through 429s.
# 0 = no throttling. 3.0 suits a 20-requests-per-minute tier.
LLM_MIN_REQUEST_INTERVAL=0

# --- OpenRouter (free tier, no card) ------------------------------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen2.5-vl-72b-instruct:free
# LLM_API_KEY=sk-or-v1-...
# LLM_MIN_REQUEST_INTERVAL=3.0
# LLM_USE_MOCK=false
# Set true ONLY for local development without a GPU. Produces deterministic
# stub responses so the pipeline is exercisable end to end; never in production.
LLM_USE_MOCK=false

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------- versioning
# Recorded on every analysis for auditability.
ANALYSIS_VERSION=1.0.0
CONFIG_DIR=./configs
DEFAULT_BANK_ID=default

# ---------------------------------------------------------------- security
AUTH_ENABLED=false
AUTH_SECRET=change-me-in-production
